{
    "Version": "20260720150000",
    "route_rules": {
        "apikey_ak_user_a": {
            "type": "apikey",
            "owner": "ak_user_a",
            "rules": [
                {
                    "name": "user_a-openai",
                    "Cond": "req_host_in(\"openai.example.org\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_openai_only",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "user_a-anthropic",
                    "Cond": "req_host_in(\"anthropic.example.org\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_anthropic_only",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                },
                {
                    "name": "user_a-both",
                    "Cond": "req_host_in(\"both.example.org\")",
                    "targets": [
                        {
                            "ClusterName": "cluster_both_protocols",
                            "Model": "",
                            "Weight": 100
                        }
                    ],
                    "fallbacks": []
                }
            ]
        }
    },
    "ApikeyRouteTableBindings": {
        "ak_user_a": [
            "apikey_ak_user_a"
        ]
    }
}
